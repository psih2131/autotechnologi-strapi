{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "singularName": "new",
    "pluralName": "news",
    "displayName": "news"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "post_title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "post_title"
    },
    "short_description": {
      "type": "text"
    },
    "post_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "post_text": {
      "type": "richtext"
    },
    "recomends_news": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::new.new",
      "mappedBy": "news"
    },
    "news": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::new.new",
      "inversedBy": "recomends_news"
    },
    "Seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
