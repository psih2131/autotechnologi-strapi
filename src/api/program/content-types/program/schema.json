    },
    "Training_program_staps": {
      "type": "component",
      "component": "shared.program-training-item",
      "repeatable": true
    },
    "Document_section": {
      "type": "component",
      "component": "shared.program-doc-sec",
      "repeatable": false
    },
    "banner_section": {
      "type": "component",
      "component": "shared.banner-v1",
      "repeatable": false
    },
    "Recommended_programs_section": {
      "type": "component",
      "component": "shared.program-recommended-sec",
      "repeatable": false
    },
    "About_company_section": {
      "type": "component",
      "component": "shared.program-about-sec",
      "repeatable": false
    },
