    },
    "programs_type": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::programs-type.programs-type",
      "inversedBy": "programs"
    },
    "registration_is_open": {
      "type": "boolean"
    },
    "best_seller": {
      "type": "boolean"
    },
    "short_description": {
      "type": "text"
    },
    "programs_training_format": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::programs-training-format.programs-training-format",
      "inversedBy": "programs"
    },
    "duration_of_study_hours": {
      "type": "float"
    },
    "price_rub": {
      "type": "integer"
    },
    "payment_in_shares_available": {
      "type": "boolean"
    },
    "long_description_for_hero_section": {
      "type": "text"
    },
    "hero_img_1": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "hero_img_2": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
